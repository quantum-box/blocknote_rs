<html><head></head><body><div><div class="bn-block-group"><div class="bn-block-container"><div class="bn-block" data-type="paragraph"><div class="bn-block-content"><span>Main Title</span></div></div></div><div class="bn-block-container"><div class="bn-block" data-type="paragraph"><div class="bn-block-content"><span>A paragraph with </span><span data-style-bold="true">bold</span><span> and </span><span data-style-italic="true">italic</span><span> text.</span></div></div></div><div class="bn-block-container"><div class="bn-block" data-type="paragraph"><div class="bn-block-content"><span>List item 1</span><span>Nested item 1.1</span></div></div></div><div class="bn-block-container"><div class="bn-block" data-type="paragraph"><div class="bn-block-content"><span>Nested item 1.2</span></div></div></div><div class="bn-block-container"><div class="bn-block" data-type="paragraph"><div class="bn-block-content"><span>List item 2</span></div></div></div><div class="bn-block-container"><div class="bn-block" data-type="paragraph"><div class="bn-block-content"><span>Another paragraph with </span><span data-style-code="true">inline code</span><span>.</span></div></div></div></div></div></body></html>
